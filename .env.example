# ==========================================================
# PK Marketing AI OS v1.0 — Environment Configuration
# ==========================================================

# Supabase PostgreSQL & Auth (Optional - Local mock/file DB active if not set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini 3.8 Flash AI API Key (Server-Side Only - Never expose to client)
GEMINI_API_KEY=

# Self-Hosted n8n Automation Engine (Optional - Local async engine active if not set)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_URL=

# App Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="PK Marketing AI OS"
